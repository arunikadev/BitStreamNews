<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_splash.xml
    Full-screen splash: logo box + brand title + pixel progress bar
    Matches Stitch Splash Screen design:
      - Dark background (#131313 / parchment in light)
      - Centered logo container with pixel border
      - Loading bar with block segments
      - Terminal status lines
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".SplashActivity">

    <!-- Main content: centered column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:gravity="center_horizontal">

        <!-- Logo container: pixel-bordered square -->
        <FrameLayout
            android:id="@+id/logo_container"
            android:layout_width="192dp"
            android:layout_height="192dp"
            android:background="@drawable/bg_logo_container"
            android:layout_marginBottom="32dp">

            <!-- Terminal icon (large) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/press_start_2p"
                android:text="[BSN]"
                android:textColor="?attr/colorPixelAccent"
                android:textSize="18sp"
                android:gravity="center" />

            <!-- Version badge: pixel label anchored bottom-center -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-8dp"
                android:background="?attr/colorPixelAccent"
                android:fontFamily="@font/press_start_2p"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/app_version"
                android:textColor="?attr/colorSurface"
                android:textSize="6sp" />

        </FrameLayout>

        <!-- App title -->
        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/press_start_2p"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="@string/splash_title"
            android:textColor="?attr/colorPixelAccent"
            android:textSize="14sp"
            android:textAllCaps="true" />

        <!-- Tagline / protocol line -->
        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/press_start_2p"
            android:gravity="center"
            android:text="@string/app_tagline"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="6sp"
            android:alpha="0.6" />

        <!-- Terminal status window -->
        <LinearLayout
            android:id="@+id/terminal_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_terminal_window"
            android:padding="16dp"
            android:layout_marginBottom="32dp"
            android:minHeight="80dp">

            <TextView
                android:id="@+id/tv_status_line_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="@string/splash_init_kernel"
                android:textColor="?attr/colorPixelAccent"
                android:textSize="6sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_status_line_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="@string/splash_decrypting"
                android:textColor="?attr/colorPixelAccent"
                android:textSize="6sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_status_line_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="@string/splash_connecting"
                android:textColor="?attr/colorPixelAccent"
                android:textSize="6sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Loading label + percentage row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_loading_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/press_start_2p"
                android:text="@string/splash_loading"
                android:textColor="?attr/colorPixelAccent"
                android:textSize="8sp"
                android:textAllCaps="true" />

            <!-- Blinking cursor block -->
            <View
                android:id="@+id/cursor_block"
                android:layout_width="12dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorPixelAccent" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="0%"
                android:textColor="?attr/colorPixelAccent"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Pixel progress bar: bordered frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_progress_frame">

            <ProgressBar
                android:id="@+id/progress_bar_splash"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_pixel"
                android:indeterminate="false" />

        </FrameLayout>

        <!-- Footer meta -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/press_start_2p"
            android:gravity="center"
            android:text="@string/app_copyright"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="5sp"
            android:alpha="0.4" />

    </LinearLayout>

</FrameLayout>
