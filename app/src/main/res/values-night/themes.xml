<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        DARK THEME — "Classic CRT" / Phosphor Green on Black
        Extracted directly from Stitch design tokens:
        - background:  #131313
        - primary:     #00E639 (phosphor green glow)
        - secondary:   #DEC800 (golden yellow)
        - error/alert: #C4000D (pixel red)
    -->

    <style name="Base.Theme.BitStreamNews" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary — Neon Green (phosphor CRT) -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/dark_on_primary_container</item>

        <!-- Secondary — Pixel Yellow -->
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorOnSecondary">@color/dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/dark_on_secondary_container</item>

        <!-- Tertiary — Pixel Red -->
        <item name="colorTertiary">@color/dark_tertiary</item>
        <item name="colorOnTertiary">@color/dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/dark_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/dark_error</item>
        <item name="colorOnError">@color/dark_on_error</item>
        <item name="colorErrorContainer">@color/dark_error_container</item>
        <item name="colorOnErrorContainer">@color/dark_on_error_container</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_on_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/dark_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/dark_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/dark_surface_container_highest</item>
        <item name="colorSurfaceContainerLowest">@color/dark_surface_container_lowest</item>

        <!-- Outline / Divider -->
        <item name="colorOutline">@color/dark_outline</item>
        <item name="colorOutlineVariant">@color/dark_outline_variant</item>

        <!-- Inverse -->
        <item name="inverseSurface">@color/dark_inverse_surface</item>
        <item name="inverseOnSurface">@color/dark_inverse_on_surface</item>
        <item name="inversePrimary">@color/dark_inverse_primary</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/press_start_2p</item>

        <!-- Window attributes -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Pixel art: NO rounded corners -->
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BitStreamNews.None</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BitStreamNews.None</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.BitStreamNews.None</item>

        <!-- Custom semantic pixel colors for dark mode -->
        <item name="colorPixelAccent">@color/dark_primary_fixed_dim</item>
        <item name="colorPixelHighlight">@color/dark_secondary_fixed_dim</item>
        <item name="colorPixelError">@color/dark_on_tertiary_container</item>
        <item name="colorPixelBorder">@color/dark_outline</item>
        <item name="colorPixelBorderVariant">@color/dark_outline_variant</item>
        <item name="colorCardBackground">@color/dark_surface_container</item>
        <item name="colorTickerBackground">@color/dark_primary_container</item>
        <item name="colorTickerText">@color/dark_on_primary_container</item>
        <item name="colorNavBackground">@color/dark_background</item>
        <item name="colorNavActiveBackground">@color/dark_primary_container</item>
        <item name="colorNavActiveText">@color/dark_on_primary_container</item>
        <item name="colorNavInactiveText">@color/dark_on_surface_variant</item>

    </style>

</resources>