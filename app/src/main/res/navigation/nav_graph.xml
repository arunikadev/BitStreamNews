<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_graph.xml — BitStreamNews Navigation Graph
    ═══════════════════════════════════════════════
    Scope: Fragment-only navigation inside MainActivity.
    NewsDetailActivity is launched via explicit Intent — NOT part of this graph.

    ┌─────────────────────────────────────────────────────────┐
    │                    NAV GRAPH MAP                        │
    │                                                         │
    │   [HomeFeedFragment] ──action_home_to_bookmark──▶       │
    │         ▲  ▲         ──action_home_to_settings──▶       │
    │         │  │                    │               │       │
    │         │  └──action_bm_to_home   action_set_to_home    │
    │         │                      │               │       │
    │   [BookmarkFragment]    [SettingsFragment] ────┘        │
    └─────────────────────────────────────────────────────────┘

    Transitions: pixel-style linear slide (no fade/crossfade).
      Forward:  enter=slide_in_right,  exit=slide_out_left
      Pop-back: enter=slide_in_left,   exit=slide_out_right

    Bottom nav tabs (Home↔Bookmark↔Settings) are treated as
    SIBLING destinations — not a back-stack. Each action uses
    popUpTo + inclusive=true to prevent stack accumulation.
-->
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFeedFragment">

    <!-- ═══════════════════════════════════════════════════════
         HOME FEED FRAGMENT
         Start destination — shows news list, ticker, search
         ═══════════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/homeFeedFragment"
        android:name="com.example.bit_stream_news.ui.home.HomeFeedFragment"
        android:label="@string/nav_feed"
        tools:layout="@layout/fragment_home_feed">

        <!-- Home → Bookmark (forward slide) -->
        <action
            android:id="@+id/action_home_to_bookmark"
            app:destination="@id/bookmarkFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFeedFragment"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />

        <!-- Home → Settings (forward slide) -->
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFeedFragment"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />

    </fragment>

    <!-- ═══════════════════════════════════════════════════════
         BOOKMARK FRAGMENT
         Saved/bookmarked articles list
         ═══════════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/bookmarkFragment"
        android:name="com.example.bit_stream_news.ui.bookmark.BookmarkFragment"
        android:label="@string/nav_bookmark"
        tools:layout="@layout/fragment_bookmark">

        <!-- Bookmark → Home (back slide) -->
        <action
            android:id="@+id/action_bookmark_to_home"
            app:destination="@id/homeFeedFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/homeFeedFragment"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />

        <!-- Bookmark → Settings (forward slide) -->
        <action
            android:id="@+id/action_bookmark_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/homeFeedFragment"
            app:popUpToInclusive="false"
            app:launchSingleTop="true" />

    </fragment>

    <!-- ═══════════════════════════════════════════════════════
         SETTINGS FRAGMENT
         BIOS-style settings: theme toggle, cache, about
         ═══════════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.bit_stream_news.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings">

        <!-- Settings → Home (back slide) -->
        <action
            android:id="@+id/action_settings_to_home"
            app:destination="@id/homeFeedFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/homeFeedFragment"
            app:popUpToInclusive="true"
            app:launchSingleTop="true" />

        <!-- Settings → Bookmark (back slide) -->
        <action
            android:id="@+id/action_settings_to_bookmark"
            app:destination="@id/bookmarkFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left"
            app:popUpTo="@id/homeFeedFragment"
            app:popUpToInclusive="false"
            app:launchSingleTop="true" />

    </fragment>

</navigation>
