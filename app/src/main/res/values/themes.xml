<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        LIGHT THEME — "Parchment Terminal"
        Background: aged parchment (#F5EDD6)
        Accent: amber/dark amber
        All border-radius = 0 (pixel art rule: no rounded corners)
        Supports runtime switching via AppCompatDelegate.setDefaultNightMode()
    -->

    <style name="Base.Theme.BitStreamNews" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary brand color (amber) -->
        <item name="colorPrimary">@color/light_primary</item>
        <item name="colorOnPrimary">@color/light_on_primary</item>
        <item name="colorPrimaryContainer">@color/light_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/light_on_primary_container</item>

        <!-- Secondary (warm brown) -->
        <item name="colorSecondary">@color/light_secondary</item>
        <item name="colorOnSecondary">@color/light_on_secondary</item>
        <item name="colorSecondaryContainer">@color/light_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/light_on_secondary_container</item>

        <!-- Tertiary (brick red / alert) -->
        <item name="colorTertiary">@color/light_tertiary</item>
        <item name="colorOnTertiary">@color/light_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/light_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/light_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/light_error</item>
        <item name="colorOnError">@color/light_on_error</item>
        <item name="colorErrorContainer">@color/light_error_container</item>
        <item name="colorOnErrorContainer">@color/light_on_error_container</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorOnBackground">@color/light_on_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_on_surface</item>
        <item name="colorSurfaceVariant">@color/light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/light_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/light_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/light_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/light_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/light_surface_container_highest</item>
        <item name="colorSurfaceContainerLowest">@color/light_surface_container_lowest</item>

        <!-- Outline / Divider -->
        <item name="colorOutline">@color/light_outline</item>
        <item name="colorOutlineVariant">@color/light_outline_variant</item>

        <!-- Inverse -->
        <item name="inverseSurface">@color/light_inverse_surface</item>
        <item name="inverseOnSurface">@color/light_inverse_on_surface</item>
        <item name="inversePrimary">@color/light_inverse_primary</item>

        <!-- Typography — Press Start 2P for all text -->
        <item name="android:fontFamily">@font/press_start_2p</item>

        <!-- Window attributes -->
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:navigationBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Pixel art: NO rounded corners anywhere -->
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.BitStreamNews.None</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.BitStreamNews.None</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.BitStreamNews.None</item>

        <!-- Custom semantic colors exposed as attributes -->
        <item name="colorPixelAccent">@color/light_primary_fixed_dim</item>
        <item name="colorPixelHighlight">@color/light_secondary_fixed_dim</item>
        <item name="colorPixelError">@color/pixel_red</item>
        <item name="colorPixelBorder">@color/light_outline</item>
        <item name="colorPixelBorderVariant">@color/light_outline_variant</item>
        <item name="colorCardBackground">@color/light_surface_container</item>
        <item name="colorTickerBackground">@color/light_primary_container</item>
        <item name="colorTickerText">@color/light_on_primary_container</item>
        <item name="colorNavBackground">@color/light_background</item>
        <item name="colorNavActiveBackground">@color/light_primary_container</item>
        <item name="colorNavActiveText">@color/light_on_primary_container</item>
        <item name="colorNavInactiveText">@color/light_on_surface_variant</item>

    </style>

    <!-- Applied theme (inherits Base, allows overlay customization) -->
    <style name="Theme.BitStreamNews" parent="Base.Theme.BitStreamNews" />

    <!-- Splash screen theme (no action bar, full screen dark) -->
    <style name="Theme.BitStreamNews.Splash" parent="Base.Theme.BitStreamNews">
        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Shape: zero radius for pixel art compliance -->
    <style name="ShapeAppearance.BitStreamNews.None" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

</resources>