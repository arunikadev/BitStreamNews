<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_nav_text_color.xml — Color state list for BottomNavigationView items.
    ?attr/ is valid in color state list resources (works on API 23+, minSdk=30 here).
    Checked = active tab. Default = inactive tab.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorPixelAccent"       android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant"  android:state_checked="false" />
</selector>
