<?xml version="1.0" encoding="utf-8"?>
<!--
    slide_in_right.xml
    Entering screen slides in from right edge → center.
    Pixel-style: instant translate with no easing (linear), matching 8-bit feel.
    Duration: 200ms (fast, snappy — retro game screen transition speed)
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <translate
        android:duration="200"
        android:fromXDelta="100%"
        android:interpolator="@android:anim/linear_interpolator"
        android:toXDelta="0%" />

</set>
